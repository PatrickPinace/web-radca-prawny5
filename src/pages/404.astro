---
import Base from '../layouts/Base.astro';
---
<Base title="Nie ma takiej strony | Piotr Gacoń — radca prawny" description="Strona nie istnieje." noindex>
  <section class="pad" style="padding-bottom: 120px">
    <div class="in">
      <h1 class="title">404</h1>
      <p class="serif" style="font-size: clamp(24px, 2.2vw, 34px); max-width: 30ch">Nie ma takiej strony. <a class="link" href="/">Wróć na stronę główną</a> albo zadzwoń — numer jest niżej.</p>
    </div>
  </section>
</Base>
<style>
  .title { margin: clamp(40px, 6vw, 96px) 0 24px -0.04em; font-family: var(--serif); font-weight: 500; font-size: clamp(120px, 20vw, 360px); line-height: 0.85; }
</style>
